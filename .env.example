# Copy this file to .env and fill it in. .env is never committed or baked into the image.

# --- AI service: choose one ---
# A) An OpenAI-compatible endpoint, such as the Coarena Model API:
AI_BASE_URL=https://coarena.ai/api/v1
AI_API_KEY=
# B) Google's Gemini API directly: leave AI_BASE_URL empty and set a key from https://aistudio.google.com/
GEMINI_API_KEY=
# With no key at all the app runs in demo mode with sample ingredients and recipes.

# Model that suggests dishes and writes recipes. On Coarena the id is gemini-3-8-flash;
# on Google's API it is gemini-3.8-flash.
GEMINI_MODEL=gemini-3-8-flash

# Model that reads the photos. Leave empty to use GEMINI_MODEL.
# A stronger model (gemini-4-carbon) finds more, but needs paid credits on Coarena.
GEMINI_VISION_MODEL=gemini-3-8-flash

# Thinking effort for photos: low, medium or high. Empty uses the model's default.
# high finds more items, including unlabelled ones, for a few seconds more per photo.
GEMINI_VISION_THINKING=high

# Port on the host machine.
PORT=8000

# Set to 1 only when the app is served over HTTPS (for example behind Caddy or nginx).
# With plain http:// on a home network leave it at 0, or sign-in will not stick.
COOKIE_SECURE=0

# Session signing key. Leave empty: one is generated on first start and kept in the data volume.
SECRET_KEY=

# Time zone used when showing dates.
TIMEZONE=Asia/Kuala_Lumpur

# Photo limits.
MAX_PHOTOS=4
MAX_UPLOAD_MB=10

# Set to 1 to force demo mode even when a key is set.
AI_MOCK=0
